# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/creative-canvas?retryWrites=true&w=majority

# Admin Email (only this email can login to admin panel)
ADMIN_EMAIL=your-email@gmail.com
ADMIN_PASSWORD=use-a-strong-server-only-password

# Optional dev/admin fallback credentials for direct env login
VITE_ADMIN_EMAIL=your-email@gmail.com
VITE_ADMIN_PASS=your-password
DEV_ADMIN_EMAIL=your-dev-email@gmail.com
DEV_ADMIN_PASSWORD=your-dev-password
VITE_DEV_ADMIN_EMAIL=your-dev-email@gmail.com
VITE_DEV_ADMIN_PASS=your-dev-password

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudflare R2 (server-side only; never prefix these with VITE_)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-bucket-scoped-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-bucket-scoped-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_BASE_URL=https://images.example.com
# Optional maximum image size in bytes (defaults to 10485760 / 10 MiB)
R2_MAX_UPLOAD_BYTES=10485760

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Node Environment
NODE_ENV=development

# Port
PORT=3000
